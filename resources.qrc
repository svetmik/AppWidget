<RCC>
    <qresource prefix="/icon">

        <file alias="ApplicationIcon.png">Resources/ApplicationIcon.png</file>

        <file alias="btn_close.png">Resources/title_button_close.png</file>
        <file alias="btn_close_hover.png">Resources/title_button_close_hover.png</file>

        <file alias="button_maximize.png">Resources/title_button_maximize.png</file>
        <file alias="button_restore.png">Resources/title_shadow_restore.png</file>

        <file alias="button_minimize.png">Resources/title_button_minimize_psd.png</file>

        <file alias="btn_close_2x.png">Resources/title_button_close@2x.png</file> 
        <file alias="btn_close_3x.png">Resources/title_button_close@3x.png</file>
    </qresource>
</RCC>